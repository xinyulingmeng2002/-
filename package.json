{
  "name": "multi-agent-collab-platform",
  "private": true,
  "workspaces": ["apps/*", "apps/bridges/*", "packages/*"],
  "scripts": {
    "dev:server": "npm --workspace @ma/server run dev",
    "dev:web": "npm --workspace @ma/web run dev",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present --include-workspace-root=false"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
